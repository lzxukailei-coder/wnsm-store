.detail { padding: 24rpx 24rpx 40rpx; color: #17243b; }
.summary, .contact-card, .status-card { background: #fff; border-radius: 20rpx; padding: 30rpx; }
.eyebrow { color: #516681; font-size: 24rpx; }
.model-title { font-size: 44rpx; line-height: 1.25; font-weight: 700; margin: 14rpx 0 8rpx; }
.quote-time, .selected-spec, .note { font-size: 26rpx; line-height: 1.55; color: #516681; }
.price-line { display: flex; align-items: center; gap: 16rpx; margin: 24rpx 0 10rpx; }
.price { font-size: 42rpx; font-weight: 700; color: #005ebc; }
.price-label, .specs text { font-size: 22rpx; padding: 6rpx 14rpx; background: #eaf3ff; border-radius: 999rpx; color: #194878; }
.specs { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.section-title { font-size: 30rpx; font-weight: 650; margin: 30rpx 4rpx 14rpx; }
.section-title text { margin-left: 12rpx; font-size: 24rpx; font-weight: 400; color: #62738a; }
.variant { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; background: #fff; border-radius: 16rpx; padding: 20rpx; margin: 0 0 12rpx; text-align: left; line-height: 1.4; border: 2rpx solid transparent; }
.variant.selected { border-color: #0067c7; background: #eef6ff; }
.variant-name { font-size: 26rpx; flex: 1; color: #17243b; }
.variant-price { font-size: 24rpx; color: #005ebc; white-space: nowrap; }
.contact-card { margin-top: 24rpx; }
.primary, .secondary { font-size: 27rpx; line-height: 2.5; border-radius: 14rpx; padding: 0 16rpx; margin-top: 16rpx; }
.primary { background: #005ebc; color: #fff; }
.secondary { background: #edf3fa; color: #234b73; }
.secondary-row { display: flex; gap: 12rpx; }
.secondary-row button { flex: 1; }
.status-card { text-align: center; color: #516681; font-size: 28rpx; }
.variant::after, .primary::after, .secondary::after { border: 0; }
