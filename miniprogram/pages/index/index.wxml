<view class="page">
  <!-- 顶部用户区 -->
  <view class="header">
    <view class="logo">蜗牛数码 <text class="hl">渠道报价</text></view>
    <view class="user-area">
      <block wx:if="{{user}}">
        <text class="user-info">{{user.role === 'B' ? (user.status === 'approved' ? '同行' : '审核中') : '客户'}}</text>
        <button class="user-btn" bindtap="onLogout">退出</button>
      </block>
      <block wx:else>
        <button class="user-btn" bindtap="goLogin">登录 / 注册</button>
      </block>
    </view>
  </view>

  <!-- 搜索 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索型号、容量或渠道，如 Mate80 256 原封" maxlength="80" value="{{keyword}}" bindinput="onSearch" bindconfirm="onSearchConfirm" confirm-type="search" />
    <view class="update-line">
      <text wx:if="{{quoteTime}}">报价更新 {{quoteTime}}（北京时间）</text>
      <text wx:if="{{page}}"> · {{count}} 条报价</text>
    </view>
  </view>

  <!-- 品类横滑 -->
  <scroll-view scroll-x class="type-bar" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{typeTabs}}" wx:key="key"
          class="ch-btn {{currentType === item.key ? 'active' : ''}}"
          data-type="{{item.key}}" bindtap="onTypeTap">{{item.name}}</view>
  </scroll-view>

  <!-- 品牌横滑 -->
  <scroll-view scroll-x class="filter-bar" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{brandList}}" wx:key="key"
          class="filter-btn {{currentBrand === item.key ? 'active' : ''}}"
          data-brand="{{item.key}}" bindtap="onBrandTap">{{item.name}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="empty">正在加载报价…</view>

  <!-- 分组商品列表 -->
  <block wx:for="{{groups}}" wx:for-item="group" wx:key="key">
    <view class="brand-title">
      <text>{{group.name}}</text>
    </view>

    <view wx:for="{{group.items}}" wx:for-item="p" wx:key="id" class="card">
      <view class="name">{{p.name}}</view>
      <view class="meta">
        <view class="price-box">
          <text class="price {{p.outStock ? 'muted' : ''}}">{{p.priceText}}</text>
          <text class="price-tag {{p.labelCls}}">{{p.labelText}}</text>
        </view>
        <button class="buy-btn" data-key="{{p.modelKey}}" data-id="{{p.id}}" bindtap="openQuote">看规格</button>
      </view>
      <view class="tags">
        <text wx:for="{{p.tags}}" wx:for-item="t" wx:key="*this" class="tag">{{t}}</text>
      </view>
    </view>
  </block>

  <view wx:if="{{error}}" class="empty">
    <text>{{error}}</text>
    <button class="retry" bindtap="retry">重新加载</button>
  </view>
  <view wx:elif="{{!loading && page && groups.length === 0}}" class="empty">没有匹配的机型，换个关键词试试</view>
  <view wx:if="{{loadingMore}}" class="load-more">正在加载更多报价…</view>
  <button wx:elif="{{hasMore && !error}}" class="load-more load-more-button" bindtap="loadMore">加载更多报价</button>

  <view class="footer-space"></view>
</view>
