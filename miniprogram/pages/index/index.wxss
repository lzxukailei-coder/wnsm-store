.page { padding-bottom: 40rpx; }

.header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  color: #fff; padding: 24rpx 32rpx;
  display: flex; justify-content: space-between; align-items: center;
}
.logo { font-size: 34rpx; font-weight: 700; }
.logo .hl { color: #ffd700; }
.user-area { display: flex; align-items: center; gap: 16rpx; }
.user-info { font-size: 24rpx; color: #ccc; }
.user-btn {
  font-size: 26rpx; color: #fff; background: rgba(255,255,255,.15);
  border: none; padding: 10rpx 28rpx; border-radius: 32rpx; line-height: 1.6;
}

.search-bar { background: #fff; padding: 20rpx 32rpx 12rpx; border-bottom: 1rpx solid #f0f0f3; }
.search-input {
  width: 100%; padding: 18rpx 28rpx; border: 1rpx solid #d2d2d7;
  border-radius: 20rpx; font-size: 28rpx; background: #f5f5f7;
}
.update-line { font-size: 22rpx; color: #86868b; padding: 10rpx 4rpx 0; }

.type-bar { display: flex; gap: 12rpx; padding: 16rpx 32rpx; background: #fff; white-space: nowrap; }
.ch-btn {
  padding: 10rpx 24rpx; border-radius: 28rpx; background: none;
  font-size: 24rpx; border: 1rpx solid #d2d2d7; color: #666; display: inline-block;
}
.ch-btn.active { background: #fff3e0; color: #f57c00; border-color: #f57c00; }

.filter-bar { display: flex; gap: 16rpx; padding: 16rpx 32rpx; background: #fff; border-bottom: 1rpx solid #e5e5ea; white-space: nowrap; }
.filter-btn {
  padding: 12rpx 28rpx; border-radius: 32rpx; background: #f5f5f7;
  font-size: 26rpx; color: #333; display: inline-block;
}
.filter-btn.active { background: #0071e3; color: #fff; }

.brand-title {
  padding: 20rpx 32rpx 12rpx; font-size: 28rpx; font-weight: 600;
  background: #f5f5f7; display: flex; justify-content: space-between;
}
.brand-title .count { font-size: 24rpx; font-weight: 400; color: #86868b; }

.card {
  background: #fff; margin: 16rpx 24rpx; border-radius: 28rpx; padding: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06);
}
.name { font-size: 28rpx; font-weight: 500; line-height: 1.5; margin-bottom: 16rpx; }
.meta { display: flex; justify-content: space-between; align-items: center; }
.price-box { display: flex; align-items: baseline; gap: 12rpx; }
.price { font-size: 40rpx; font-weight: 700; color: #ff3b30; }
.price.muted { color: #86868b; font-size: 28rpx; font-weight: 400; }
.price-tag { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: 500; }
.tag-c { background: #e3f2fd; color: #1976d2; }
.tag-b { background: #fce4ec; color: #c2185b; }
.tag-p { background: #fff8e1; color: #f9a825; }
.tag-public { background: #eceff1; color: #607d8b; }

.buy-btn {
  background: linear-gradient(135deg, #0071e3, #0056b3); color: #fff;
  border: none; padding: 14rpx 32rpx; border-radius: 20rpx; font-size: 26rpx;
  line-height: 1.6;
}
.buy-btn[disabled] { background: #ccc; }

.tags { display: flex; gap: 8rpx; flex-wrap: wrap; margin-top: 16rpx; }
.tags .tag { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 8rpx; background: #f0f0f3; color: #555; }

.empty { text-align: center; padding: 120rpx 40rpx; color: #86868b; font-size: 28rpx; }
.load-more { margin: 20rpx 24rpx; padding: 18rpx; color: #516681; font-size: 26rpx; text-align: center; }
.load-more-button { line-height: 1.5; color: #005ebc; background: #eaf3ff; }
.load-more-button::after { border: 0; }
.retry { margin-top: 32rpx; background: #0071e3; color: #fff; border-radius: 20rpx; font-size: 26rpx; }
.footer-space { height: 60rpx; }
